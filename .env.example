HTTP_ADDR=:8080

# Local dev-stack Postgres (user root / password, port 5432)
DATABASE_URL=postgres://root:password@localhost:5432/auth?sslmode=disable

# Redis for global API rate limiting + login brute-force (dev-stack or deploy/compose redis)
REDIS_URL=redis://localhost:6379

JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_TTL_SECONDS=3600
JWT_ISSUER=auth

REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=3
PASSWORD_RESET_TTL_HOURS=1

# Mailpit (dev-stack): SMTP :1025, UI https://mail.localhost:8443/
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@auth.local
WEB_BASE_URL=http://localhost:3000

ERROR_TYPE_BASE_URL=https://auth.local/errors
